{
  "name": "@access-tools/place",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Accessible place pages: every field with source, date, and verification tier.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "pretest": "tsc -p ../../node_modules/access-main/packages/schema/tsconfig.json",
    "pretypecheck": "tsc -p ../../node_modules/access-main/packages/schema/tsconfig.json",
    "prebuild": "tsc -p ../../node_modules/access-main/packages/schema/tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "vite build",
    "demo": "vite"
  },
  "dependencies": {
    "access-main": "github:ALENZACODES/access-main#ce179e15393f46a415cacbee8afe476bbd0f419d",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.10.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^3.0.4"
  }
